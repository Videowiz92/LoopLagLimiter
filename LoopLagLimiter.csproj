<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build on Windows with build.bat (or: dotnet build -c Release) -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>LoopLagLimiter</AssemblyName>
    <RootNamespace>LoopLagLimiter</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Version>1.2.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)'==''">E:\SteamLibrary\steamapps\common\Risk of Rain 2</GameDir>
    <ProfileDir Condition="'$(ProfileDir)'==''">$(APPDATA)\r2modmanPlus-local\RiskOfRain2\profiles\Quality</ProfileDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="bin\**;obj\**;package\**;patcher\**" />
    <EmbeddedResource Include="src\icon.png" LogicalName="LoopLagLimiter.icon.png" />
    <Reference Include="BepInEx"><HintPath>$(ProfileDir)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(ProfileDir)\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameDir)\Risk of Rain 2_Data\Managed\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameDir)\Risk of Rain 2_Data\Managed\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(GameDir)\Risk of Rain 2_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
